{
  "expo": {
    "name": "Digital Vault",
    "slug": "digital-vault-2",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "digitalvault",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.digitalvault.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366f1"
      },
      "package": "com.digitalvault.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
